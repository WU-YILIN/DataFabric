# ============================================================
# Genesis Ingestion Gateway — Environment Configuration
# Copy to .env and fill in values before starting the service.
# ============================================================

# HTTP server listen address
LISTEN_ADDR=:8080

# Kafka broker list (comma-separated for multiple brokers)
KAFKA_BROKERS=localhost:9092

# Kafka topic where raw events land (the ODS beachhead)
KAFKA_TOPIC=ods_raw_events

# Redis — used to sync API keys from DataFabric backend
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ── Security ────────────────────────────────────────────────
# Maximum request body size in bytes (default 524288 = 512 KB)
MAX_BODY_BYTES=524288

# Per-IP requests per second (token bucket)
RATE_LIMIT_PER_SEC=200
RATE_LIMIT_BURST=500

# Shared secret used by DataFabric to call /admin/keys
# MUST be changed in production — never commit the real value
INTERNAL_API_KEY=change-me-in-production

# ── Kafka Producer Tuning ───────────────────────────────────
# In-process async channel buffer (number of messages)
PRODUCER_QUEUE_SIZE=10000

# Max messages per Kafka batch
PRODUCER_BATCH_SIZE=1000

# Max milliseconds to wait before flushing a partial batch
PRODUCER_FLUSH_MS=500

# ── Logging ─────────────────────────────────────────────────
# Set to "json" for structured JSON logs in production
LOG_FORMAT=json
